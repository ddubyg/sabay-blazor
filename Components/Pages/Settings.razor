@page "/settings"

<PageTitle>Settings - Sabay?</PageTitle>

<div class="mx-auto max-w-3xl">
    <h1 class="text-3xl font-bold text-gray-900">Settings</h1>
    <p class="mt-2 text-gray-500">Manage your Sabay? preferences.</p>

    <div class="mt-8 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">

        <div class="flex items-center justify-between border-b border-gray-100 py-4">
            <div>
                <p class="font-semibold text-gray-800">Notifications</p>
                <p class="text-sm text-gray-500">Receive activity updates.</p>
            </div>

            <input type="checkbox" checked class="h-5 w-5 accent-violet-600" />
        </div>

        <div class="flex items-center justify-between py-4">
            <div>
                <p class="font-semibold text-gray-800">Dark Mode</p>
                <p class="text-sm text-gray-500">Use a darker interface.</p>
            </div>

            <input type="checkbox" class="h-5 w-5 accent-violet-600" />
        </div>

    </div>
</div>