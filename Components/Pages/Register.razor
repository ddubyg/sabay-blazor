@page "/register"
@layout EmptyLayout

<PageTitle>Sabay? - Register</PageTitle>

<div class="login-page">

    <div class="login-card">

        <div class="login-brand">

            <div class="sabay-logo">
                S
            </div>

            <h1>Create Account</h1>

            <p>
                Join your fellow students.
            </p>

        </div>

        <div class="sabay-form-group">

            <label>Full Name</label>

            <input class="sabay-input"
                   placeholder="Your name" />

        </div>

        <div class="sabay-form-group">

            <label>School Email</label>

            <input class="sabay-input"
                   type="email"
                   placeholder="you@cit.edu" />

        </div>

        <div class="sabay-form-group">

            <label>Password</label>

            <input class="sabay-input"
                   type="password"
                   placeholder="Create a password" />

        </div>

        <a href="/login"
           class="sabay-btn sabay-btn-primary"
           style="display:block; text-align:center;">
            Create Account
        </a>

        <p style="text-align:center; margin-top:20px; color:#71717a;">
            Already have an account?
            <a href="/login" style="color:#6c5ce7;">
                Login
            </a>
        </p>

    </div>

</div>