```razor
@page "/"
@using sabaycs321.Services

<PageTitle>Home - Sabay?</PageTitle>

<div class="mx-auto max-w-7xl">

    <div class="rounded-3xl bg-violet-600 p-8 text-white shadow-lg">

        <p class="text-sm font-semibold uppercase tracking-wide text-violet-200">
            Welcome to Sabay?
        </p>

        <h1 class="mt-2 text-4xl font-bold">
            Find someone to do things with.
        </h1>

        <p class="mt-3 max-w-2xl text-violet-100">
            Find classmates for studying, sports, food, gaming,
            commuting, and hanging out.
        </p>

        <div class="mt-6 flex flex-wrap gap-3">

            <a
                href="/browse"
                class="rounded-xl bg-white px-5 py-3 font-semibold text-violet-700 transition hover:bg-violet-50">
                Browse Activities
            </a>

            <a
                href="/create"
                class="rounded-xl border border-violet-300 px-5 py-3 font-semibold text-white transition hover:bg-violet-500">
                Create Activity
            </a>

        </div>

    </div>

    <div class="mt-10 flex flex-col justify-between gap-3 sm:flex-row sm:items-center">

        <div>

            <h2 class="text-2xl font-bold text-gray-900">
                Recent Activities
            </h2>

            <p class="mt-1 text-gray-500">
                See what students are doing.
            </p>

        </div>

        <a
            href="/browse"
            class="font-semibold text-violet-600 hover:text-violet-700">
            View all →
        </a>

    </div>

    <div class="mt-5 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">

        @foreach (var activity in ActivityStore.Activities.Take(3))
        {
            <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-md">

                <span class="rounded-full bg-violet-100 px-3 py-1 text-xs font-semibold text-violet-700">
                    @activity.Category
                </span>

                <h3 class="mt-4 text-xl font-bold text-gray-900">
                    @activity.Title
                </h3>

                <p class="mt-2 text-sm text-gray-500">
                    @activity.Description
                </p>

                <div class="mt-4 space-y-2 text-sm text-gray-600">
                    <p>📍 @activity.Location</p>
                    <p>📅 @activity.Date</p>
                    <p>🕐 @activity.Time</p>
                </div>

                <a
                    href="/activity/@activity.Id"
                    class="mt-5 block rounded-xl bg-violet-600 px-4 py-3 text-center font-semibold text-white hover:bg-violet-700">
                    View Details
                </a>

            </div>
        }

    </div>

</div>
