```razor
@page "/activity/{Id:int}"
@rendermode InteractiveServer
@using sabaycs321.Services

<PageTitle>Activity Details - Sabay?</PageTitle>

@if (Activity == null)
{
    <div class="mx-auto max-w-3xl rounded-2xl border border-gray-200 bg-white p-10 text-center">
        <h1 class="text-2xl font-bold text-gray-900">
            Activity not found
        </h1>

        <a
            href="/browse"
            class="mt-5 inline-block rounded-xl bg-violet-600 px-5 py-3 font-semibold text-white hover:bg-violet-700">
            Back to Activities
        </a>
    </div>
}
else
{
    <div class="mx-auto max-w-3xl">

        <a
            href="/browse"
            class="text-sm font-semibold text-violet-600 hover:text-violet-700">
            ← Back to Browse
        </a>

        <div class="mt-5 rounded-2xl border border-gray-200 bg-white p-7 shadow-sm">

            <div class="flex flex-wrap items-center justify-between gap-3">

                <span class="rounded-full bg-violet-100 px-3 py-1 text-sm font-semibold text-violet-700">
                    @Activity.Category
                </span>

                <span class="text-sm text-gray-500">
                    @Activity.Participants.Count / @Activity.Needed participants
                </span>

            </div>

            <h1 class="mt-5 text-3xl font-bold text-gray-900">
                @Activity.Title
            </h1>

            <p class="mt-3 text-gray-600">
                @Activity.Description
            </p>

            <div class="mt-7 grid grid-cols-1 gap-4 md:grid-cols-2">

                <div class="rounded-xl bg-gray-50 p-4">
                    <p class="text-xs font-semibold uppercase text-gray-400">
                        Location
                    </p>

                    <p class="mt-1 font-semibold text-gray-800">
                        📍 @Activity.Location
                    </p>
                </div>

                <div class="rounded-xl bg-gray-50 p-4">
                    <p class="text-xs font-semibold uppercase text-gray-400">
                        Date
                    </p>

                    <p class="mt-1 font-semibold text-gray-800">
                        📅 @Activity.Date
                    </p>
                </div>

                <div class="rounded-xl bg-gray-50 p-4">
                    <p class="text-xs font-semibold uppercase text-gray-400">
                        Time
                    </p>

                    <p class="mt-1 font-semibold text-gray-800">
                        🕐 @Activity.Time
                    </p>
                </div>

                <div class="rounded-xl bg-gray-50 p-4">
                    <p class="text-xs font-semibold uppercase text-gray-400">
                        Created By
                    </p>

                    <p class="mt-1 font-semibold text-gray-800">
                        @Activity.Creator
                    </p>
                </div>

            </div>

            <div class="mt-7">

                <h2 class="text-lg font-bold text-gray-900">
                    Participants
                </h2>

                <div class="mt-3 space-y-2">

                    @foreach (var participant in Activity.Participants)
                    {
                        <div class="rounded-xl bg-gray-50 px-4 py-3 text-sm font-medium text-gray-700">
                            👤 @participant
                        </div>
                    }

                </div>

            </div>

            @if (!string.IsNullOrEmpty(message))
            {
                <div class="mt-5 rounded-xl bg-violet-50 p-4 text-sm font-medium text-violet-700">
                    @message
                </div>
            }

            @if (Activity.Participants.Contains("You"))
            {
                <button
                    disabled
                    class="mt-6 w-full cursor-not-allowed rounded-xl bg-green-500 px-5 py-3 font-semibold text-white">
                    ✓ You Joined This Activity
                </button>
            }
            else
            {
                <button
                    @onclick="Join"
                    disabled="@(Activity.Participants.Count >= Activity.Needed)"
                    class="mt-6 w-full rounded-xl bg-violet-600 px-5 py-3 font-semibold text-white transition hover:bg-violet-700 disabled:cursor-not-allowed disabled:bg-gray-300">
                    @(Activity.Participants.Count >= Activity.Needed
                        ? "Activity Full"
                        : "Join Activity")
                </button>
            }

        </div>

    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private ActivityItem? Activity;
    private string message = "";

    protected override void OnInitialized()
    {
        Activity = ActivityStore.GetActivity(Id);
    }

    private void Join()
    {
        if (Activity == null)
            return;

        var success = ActivityStore.JoinActivity(Id, "You");

        message = success
            ? "You joined this activity successfully!"
            : "You are already a participant or the activity is full.";
    }
}
```

Then:

```powershell
dotnet build
```

Then commit:

```powershell
git add .
git commit -m "feat: prevent duplicate activity joins"
```

