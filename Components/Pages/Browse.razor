```razor
@page "/browse"
@rendermode InteractiveServer
@using sabaycs321.Services

<PageTitle>Browse Activities - Sabay?</PageTitle>

<div class="mx-auto max-w-7xl">

    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900">
            Browse Activities
        </h1>

        <p class="mt-2 text-gray-500">
            Find something to do with other students.
        </p>
    </div>

    <!-- Search and Filters -->
    <div class="mb-6 grid grid-cols-1 gap-4 md:grid-cols-4">

        <input
            @bind="searchText"
            @bind:event="oninput"
            placeholder="Search activities..."
            class="rounded-xl border border-gray-300 bg-white px-4 py-3 outline-none transition focus:border-violet-500 focus:ring-2 focus:ring-violet-100" />

        <select
            @bind="selectedCategory"
            class="rounded-xl border border-gray-300 bg-white px-4 py-3 outline-none focus:border-violet-500">
            <option value="All">All Categories</option>
            <option value="Studying">Studying</option>
            <option value="Sports">Sports</option>
            <option value="Food">Food</option>
            <option value="Gaming">Gaming</option>
            <option value="Commuting">Commuting</option>
            <option value="Hanging Out">Hanging Out</option>
        </select>

        <input
            @bind="locationFilter"
            @bind:event="oninput"
            placeholder="Filter by location..."
            class="rounded-xl border border-gray-300 bg-white px-4 py-3 outline-none transition focus:border-violet-500 focus:ring-2 focus:ring-violet-100" />

        <button
            @onclick="ClearFilters"
            class="rounded-xl border border-gray-300 bg-white px-4 py-3 font-semibold text-gray-700 transition hover:bg-gray-50">
            Clear Filters
        </button>

    </div>

    <!-- Activity Cards -->
    @if (FilteredActivities.Any())
    {
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">

            @foreach (var activity in FilteredActivities)
            {
                <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-md">

                    <div class="mb-4 flex items-start justify-between gap-3">

                        <span class="rounded-full bg-violet-100 px-3 py-1 text-xs font-semibold text-violet-700">
                            @activity.Category
                        </span>

                        <span class="text-sm text-gray-500">
                            @activity.Participants.Count/@activity.Needed
                        </span>

                    </div>

                    <h2 class="text-xl font-bold text-gray-900">
                        @activity.Title
                    </h2>

                    <p class="mt-2 text-sm text-gray-500">
                        @activity.Description
                    </p>

                    <div class="mt-5 space-y-2 text-sm text-gray-600">
                        <p>📍 @activity.Location</p>
                        <p>📅 @activity.Date</p>
                        <p>🕐 @activity.Time</p>
                    </div>

                    <a
                        href="/activity/@activity.Id"
                        class="mt-5 block w-full rounded-xl bg-violet-600 px-4 py-3 text-center font-semibold text-white transition hover:bg-violet-700">
                        View Activity
                    </a>

                </div>
            }

        </div>
    }
    else
    {
        <div class="rounded-2xl border border-dashed border-gray-300 bg-white p-12 text-center">

            <h2 class="text-xl font-bold text-gray-800">
                No activities found
            </h2>

            <p class="mt-2 text-gray-500">
                Try changing your search or filters.
            </p>

        </div>
    }

</div>

@code {
    private string searchText = "";
    private string selectedCategory = "All";
    private string locationFilter = "";

    private IEnumerable<ActivityItem> FilteredActivities =>
        ActivityStore.Activities.Where(activity =>
            (string.IsNullOrWhiteSpace(searchText) ||
             activity.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
             activity.Description.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            &&
            (selectedCategory == "All" ||
             activity.Category == selectedCategory)
            &&
            (string.IsNullOrWhiteSpace(locationFilter) ||
             activity.Location.Contains(locationFilter, StringComparison.OrdinalIgnoreCase))
        );

    private void ClearFilters()
    {
        searchText = "";
        selectedCategory = "All";
        locationFilter = "";
    }
}
