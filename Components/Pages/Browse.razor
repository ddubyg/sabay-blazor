@page "/browse"

<PageTitle>Sabay? - Browse</PageTitle>

<div class="sabay-top">

    <div>
        <h1 class="sabay-title">Browse Activities</h1>

        <p class="sabay-subtitle">
            Find something you want to do.
        </p>
    </div>

    <a href="/create" class="sabay-btn sabay-btn-primary">
        + Create Activity
    </a>

</div>

<div class="sabay-filters">

    <button class="sabay-filter selected">All</button>
    <button class="sabay-filter">Study</button>
    <button class="sabay-filter">Sports</button>
    <button class="sabay-filter">Food</button>
    <button class="sabay-filter">Gaming</button>
    <button class="sabay-filter">Commute</button>
    <button class="sabay-filter">Hangout</button>

</div>

<div class="sabay-grid">

    <div class="activity-card">

        <h3>🎾 Tennis After Class</h3>

        <p class="activity-description">
            Need one more player for a casual tennis session.
        </p>

        <div class="activity-info">
            <span>📍 CIT-U Tennis Court</span>
            <span>📅 Friday, 5:00 PM</span>
            <span>👥 1 / 2 joined</span>
        </div>

        <div class="activity-footer">
            <span class="activity-tag">Sports</span>

            <a href="/activity" class="sabay-btn sabay-btn-primary">
                View
            </a>
        </div>

    </div>

    <div class="activity-card">

        <h3>📚 CS Exam Study Group</h3>

        <p class="activity-description">
            Studying together for the upcoming CS exam.
        </p>

        <div class="activity-info">
            <span>📍 CIT-U Library</span>
            <span>📅 Saturday, 2:00 PM</span>
            <span>👥 3 / 5 joined</span>
        </div>

        <div class="activity-footer">
            <span class="activity-tag">Study</span>

            <a href="/activity" class="sabay-btn sabay-btn-primary">
                View
            </a>
        </div>

    </div>

    <div class="activity-card">

        <h3>🎮 MLBB Party</h3>

        <p class="activity-description">
            Looking for two more players for tonight.
        </p>

        <div class="activity-info">
            <span>📍 Online</span>
            <span>📅 Tonight, 8:00 PM</span>
            <span>👥 3 / 5 joined</span>
        </div>

        <div class="activity-footer">
            <span class="activity-tag">Gaming</span>

            <a href="/activity" class="sabay-btn sabay-btn-primary">
                View
            </a>
        </div>

    </div>

    <div class="activity-card">

        <h3>🍔 Lunch Buddies</h3>

        <p class="activity-description">
            Anyone free for lunch around IT Park?
        </p>

        <div class="activity-info">
            <span>📍 IT Park</span>
            <span>📅 Friday, 12:00 PM</span>
            <span>👥 2 / 4 joined</span>
        </div>

        <div class="activity-footer">
            <span class="activity-tag">Food</span>

            <a href="/activity" class="sabay-btn sabay-btn-primary">
                View
            </a>
        </div>

    </div>

</div>