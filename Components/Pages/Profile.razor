@page "/profile"

<PageTitle>Sabay? - Profile</PageTitle>

<div class="sabay-top">

    <div>
        <h1 class="sabay-title">My Profile</h1>

        <p class="sabay-subtitle">
            Manage your Sabay? profile.
        </p>
    </div>

</div>

<div class="profile-card">

    <div class="profile-header">

        <div class="profile-avatar">
            DD
        </div>

        <div>

            <div class="profile-name">
                Your Name
            </div>

            <div class="profile-course">
                BS Computer Science
            </div>

        </div>

    </div>

    <h3>About Me</h3>

    <p class="activity-description">
        Computer Science student who enjoys sports, gaming,
        studying and hanging out with friends.
    </p>

    <h3>My Interests</h3>

    <div class="sabay-filters">

        <span class="activity-tag">🎾 Tennis</span>
        <span class="activity-tag">🎮 Gaming</span>
        <span class="activity-tag">📚 Studying</span>
        <span class="activity-tag">🍔 Food</span>

    </div>

    <button class="sabay-btn sabay-btn-secondary">
        Edit Profile
    </button>

</div>