@page "/"

<PageTitle>Sabay? - Home</PageTitle>

<div class="sabay-top">

    <div>
        <h1 class="sabay-title">Good morning! 👋</h1>
        <p class="sabay-subtitle">
            Find people to do things with.
        </p>
    </div>

    <input class="sabay-search"
           placeholder="Search activities..." />

</div>

<h2 class="sabay-section-title">What do you want to do?</h2>

<div class="sabay-categories">

    <a class="sabay-category" href="/browse">
        <div class="sabay-category-icon">📚</div>
        <div class="sabay-category-name">Study</div>
    </a>

    <a class="sabay-category" href="/browse">
        <div class="sabay-category-icon">🎾</div>
        <div class="sabay-category-name">Sports</div>
    </a>

    <a class="sabay-category" href="/browse">
        <div class="sabay-category-icon">🍔</div>
        <div class="sabay-category-name">Food</div>
    </a>

    <a class="sabay-category" href="/browse">
        <div class="sabay-category-icon">🎮</div>
        <div class="sabay-category-name">Gaming</div>
    </a>

    <a class="sabay-category" href="/browse">
        <div class="sabay-category-icon">🚌</div>
        <div class="sabay-category-name">Commute</div>
    </a>

    <a class="sabay-category" href="/browse">
        <div class="sabay-category-icon">🎉</div>
        <div class="sabay-category-name">Hangout</div>
    </a>

</div>

<div class="sabay-top">
    <div>
        <h2 class="sabay-section-title">Recommended for you</h2>
        <p class="sabay-subtitle">
            Activities happening around campus.
        </p>
    </div>

    <a href="/browse" class="sabay-btn sabay-btn-secondary">
        View all
    </a>
</div>

<div class="sabay-grid">

    <div class="activity-card">
        <h3>🎾 Tennis at CIT-U</h3>

        <p class="activity-description">
            Looking for someone to play tennis after class.
        </p>

        <div class="activity-info">
            <span>📍 CIT-U Tennis Court</span>
            <span>📅 Friday, 5:00 PM</span>
            <span>👥 1 / 2 joined</span>
        </div>

        <div class="activity-footer">
            <span class="activity-tag">Sports</span>

            <a href="/activity" class="sabay-btn sabay-btn-primary">
                Join
            </a>
        </div>
    </div>

    <div class="activity-card">
        <h3>📚 Study Session</h3>

        <p class="activity-description">
            Let's study together for the upcoming exam.
        </p>

        <div class="activity-info">
            <span>📍 Library</span>
            <span>📅 Saturday, 2:00 PM</span>
            <span>👥 2 / 5 joined</span>
        </div>

        <div class="activity-footer">
            <span class="activity-tag">Study</span>

            <a href="/activity" class="sabay-btn sabay-btn-primary">
                Join
            </a>
        </div>
    </div>

    <div class="activity-card">
        <h3>🍔 Lunch at IT Park</h3>

        <p class="activity-description">
            Looking for classmates to grab lunch with.
        </p>

        <div class="activity-info">
            <span>📍 IT Park</span>
            <span>📅 Friday, 12:00 PM</span>
            <span>👥 2 / 4 joined</span>
        </div>

        <div class="activity-footer">
            <span class="activity-tag">Food</span>

            <a href="/activity" class="sabay-btn sabay-btn-primary">
                Join
            </a>
        </div>
    </div>

</div>