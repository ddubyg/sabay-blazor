@page "/activities"

<PageTitle>My Activities - Sabay?</PageTitle>

<div class="mx-auto max-w-5xl">
    <h1 class="text-3xl font-bold text-gray-900">My Activities</h1>
    <p class="mt-2 text-gray-500">Activities you have joined or created.</p>

    <div class="mt-8 rounded-2xl border border-gray-200 bg-white p-10 text-center shadow-sm">
