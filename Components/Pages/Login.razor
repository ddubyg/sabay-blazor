@page "/login"
@layout EmptyLayout

<PageTitle>Sabay? - Login</PageTitle>

<div class="login-page">

    <div class="login-card">

        <div class="login-brand">

            <div class="sabay-logo">
                S
            </div>

            <h1>Sabay?</h1>

            <p>
                Find people to do things with.
            </p>

        </div>

        <div class="sabay-form-group">

            <label>School Email</label>

            <input class="sabay-input"
                   type="email"
                   placeholder="you@cit.edu" />

        </div>

        <div class="sabay-form-group">

            <label>Password</label>

            <input class="sabay-input"
                   type="password"
                   placeholder="Enter your password" />

        </div>

        <a href="/" class="sabay-btn sabay-btn-primary"
           style="display:block; text-align:center;">
            Login
        </a>

        <p style="text-align:center; margin-top:20px; color:#71717a;">
            Don't have an account?
            <a href="/register" style="color:#6c5ce7;">
                Create one
            </a>
        </p>

    </div>

</div>